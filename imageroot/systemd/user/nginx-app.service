[Unit]
Description=Podman nginx-app.service
BindsTo=kobotoolbox.service
After=kobotoolbox.service kpi-app.service enketo_express-app.service

[Service]
Environment=PODMAN_SYSTEMD_UNIT=%n
EnvironmentFile=%E/state/environment
# KOBO_* secrets, generated by create-module (mode 0600)
EnvironmentFile=%E/state/secrets.env
WorkingDirectory=%E/state
Restart=always
RestartSec=10
TimeoutStopSec=70
ExecStartPre=/bin/rm -f %t/nginx-app.pid %t/nginx-app.ctr-id
ExecStart=/usr/bin/podman run --conmon-pidfile %t/nginx-app.pid \
    --cidfile %t/nginx-app.ctr-id --cgroups=no-conmon \
    --pod-id-file %t/kobotoolbox.pod-id --replace -d --name nginx-app \
    --volume=%E/etc/nginx/default.conf:/etc/nginx/conf.d/default.conf:ro,Z \
    --volume=static-files:/srv/www/kpi:ro,z \
    --volume=kobocat-media:/media:ro,z \
    --volume=kpi-media:/srv/kpi_media:ro,z \
    ${NGINX_IMAGE}
ExecStop=/usr/bin/podman stop --ignore --cidfile %t/nginx-app.ctr-id -t 10
ExecStopPost=/usr/bin/podman rm --ignore -f --cidfile %t/nginx-app.ctr-id
SyslogIdentifier=%u
PIDFile=%t/nginx-app.pid
Type=forking

[Install]
WantedBy=default.target
