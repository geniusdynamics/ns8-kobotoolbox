[Unit]
Description=Podman kpi_worker-app.service
BindsTo=kobotoolbox.service
After=kobotoolbox.service postgres-app.service mongo-app.service redis-app.service kpi-app.service

[Service]
Environment=PODMAN_SYSTEMD_UNIT=%n
EnvironmentFile=%E/state/environment
# KOBO_* secrets, generated by create-module (mode 0600)
EnvironmentFile=%E/state/secrets.env
WorkingDirectory=%E/state
Restart=always
RestartSec=10
TimeoutStopSec=70
ExecStartPre=/bin/rm -f %t/kpi_worker-app.pid %t/kpi_worker-app.ctr-id
ExecStart=/usr/bin/podman run --conmon-pidfile %t/kpi_worker-app.pid \
    --cidfile %t/kpi_worker-app.ctr-id --cgroups=no-conmon \
    --pod-id-file %t/kobotoolbox.pod-id --replace -d --name kpi_worker-app \
    --env-file=%E/state/kpi.env \
    --env=POSTGRES_PASSWORD=${KOBO_DB_PASSWORD} \
    --env=DATABASE_URL=postgis://kobo:${KOBO_DB_PASSWORD}@127.0.0.1:5432/kobotoolbox \
    --env=KC_DATABASE_URL=postgis://kobo:${KOBO_DB_PASSWORD}@127.0.0.1:5432/kobocat \
    --env=DJANGO_SECRET_KEY=${KOBO_DJANGO_SECRET_KEY} \
    --env=ENKETO_API_KEY=${KOBO_ENKETO_API_KEY} \
    --env=KOBO_SUPERUSER_PASSWORD=${KOBO_SUPERUSER_PASSWORD} \
    --volume=kpi-media:/srv/src/kpi/media:z \
    --volume=kobocat-media:/srv/src/kobocat/media:z \
    ${KPI_IMAGE} \
    /bin/bash -c "source /etc/profile && exec celery -A kobo worker --beat --loglevel=info --hostname=kpi_worker@%%h --queues=kpi_queue,kpi_low_priority_queue,kpi_long_running_tasks_queue,kobocat_queue --scheduler kobo.apps.beat.schedulers:ThrottledDatabaseScheduler --schedule=/tmp/celerybeat-schedule --pidfile=/tmp/celery_worker.pid --uid=kobo --gid=kobo --autoscale=2,1"
ExecStop=/usr/bin/podman stop --ignore --cidfile %t/kpi_worker-app.ctr-id -t 10
ExecStopPost=/usr/bin/podman rm --ignore -f --cidfile %t/kpi_worker-app.ctr-id
SyslogIdentifier=%u
PIDFile=%t/kpi_worker-app.pid
Type=forking

[Install]
WantedBy=default.target
