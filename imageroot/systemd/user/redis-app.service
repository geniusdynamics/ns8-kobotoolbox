[Unit]
Description=Podman redis-app.service
BindsTo=kobotoolbox.service
After=kobotoolbox.service
Before=kpi-app.service kpi_worker-app.service enketo_express-app.service

[Service]
Environment=PODMAN_SYSTEMD_UNIT=%n
EnvironmentFile=%E/state/environment
# KOBO_* secrets, generated by create-module (mode 0600)
EnvironmentFile=%E/state/secrets.env
WorkingDirectory=%E/state
Restart=always
RestartSec=10
TimeoutStopSec=70
ExecStartPre=/bin/rm -f %t/redis-app.pid %t/redis-app.ctr-id
ExecStart=/usr/bin/podman run --conmon-pidfile %t/redis-app.pid \
    --cidfile %t/redis-app.ctr-id --cgroups=no-conmon \
    --pod-id-file %t/kobotoolbox.pod-id --replace -d --name redis-app \
    --volume=redis-data:/data:Z \
    ${VALKEY_IMAGE} valkey-server --appendonly yes --bind 127.0.0.1 --port 6379
ExecStartPost=/usr/bin/bash %E/bin/wait-ready redis-app valkey-cli ping
ExecStop=/usr/bin/podman stop --ignore --cidfile %t/redis-app.ctr-id -t 10
ExecStopPost=/usr/bin/podman rm --ignore -f --cidfile %t/redis-app.ctr-id
SyslogIdentifier=%u
PIDFile=%t/redis-app.pid
Type=forking

[Install]
WantedBy=default.target
