#
# The entrypoint of the KPI image creates the databases, applies the KPI and
# KoboCAT migrations, then starts uWSGI on 127.0.0.1:8000. The unit reports
# started only when uWSGI listens: the workers need the database schema.
# Crash-looping units would restart the whole pod, as kobotoolbox.service
# Requires= them and systemd propagates their automatic restarts.

[Unit]
Description=Podman kpi-app.service
BindsTo=kobotoolbox.service
After=kobotoolbox.service postgres-app.service mongo-app.service redis-app.service
Before=kpi_worker-app.service nginx-app.service

[Service]
Environment=PODMAN_SYSTEMD_UNIT=%n
EnvironmentFile=%E/state/environment
# KOBO_* secrets, generated by create-module (mode 0600)
EnvironmentFile=%E/state/secrets.env
WorkingDirectory=%E/state
Restart=always
RestartSec=10
TimeoutStartSec=1800
TimeoutStopSec=70
ExecStartPre=/bin/rm -f %t/kpi-app.pid %t/kpi-app.ctr-id
ExecStart=/usr/bin/podman run --conmon-pidfile %t/kpi-app.pid \
    --cidfile %t/kpi-app.ctr-id --cgroups=no-conmon \
    --pod-id-file %t/kobotoolbox.pod-id --replace -d --name kpi-app \
    --env-file=%E/state/kpi.env \
    --env=POSTGRES_PASSWORD=${KOBO_DB_PASSWORD} \
    --env=DATABASE_URL=postgis://kobo:${KOBO_DB_PASSWORD}@127.0.0.1:5432/kobotoolbox \
    --env=KC_DATABASE_URL=postgis://kobo:${KOBO_DB_PASSWORD}@127.0.0.1:5432/kobocat \
    --env=DJANGO_SECRET_KEY=${KOBO_DJANGO_SECRET_KEY} \
    --env=ENKETO_API_KEY=${KOBO_ENKETO_API_KEY} \
    --env=KOBO_SUPERUSER_PASSWORD=${KOBO_SUPERUSER_PASSWORD} \
    --volume=kpi-media:/srv/src/kpi/media:z \
    --volume=kobocat-media:/srv/src/kobocat/media:z \
    --volume=static-files:/srv/static:z \
    --volume=%E/bin/kpi-init:/srv/init:ro,Z \
    ${KPI_IMAGE} \
    /bin/bash -c "sed -i -e '/^logto/d' -e 's/^listen .*/listen = 128/' docker/uwsgi.ini && cp dependencies/pip/requirements.txt /srv/tmp/pip_dependencies.txt && exec /bin/bash docker/entrypoint.sh"
ExecStartPost=/usr/bin/bash %E/bin/wait-ready kpi-app bash -c "echo > /dev/tcp/127.0.0.1/8000"
ExecStop=/usr/bin/podman stop --ignore --cidfile %t/kpi-app.ctr-id -t 10
ExecStopPost=/usr/bin/podman rm --ignore -f --cidfile %t/kpi-app.ctr-id
SyslogIdentifier=%u
PIDFile=%t/kpi-app.pid
Type=forking

[Install]
WantedBy=default.target
