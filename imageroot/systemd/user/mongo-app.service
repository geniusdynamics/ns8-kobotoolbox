[Unit]
Description=Podman mongo-app.service
BindsTo=kobotoolbox.service
After=kobotoolbox.service
Before=kpi-app.service kpi_worker-app.service

[Service]
Environment=PODMAN_SYSTEMD_UNIT=%n
EnvironmentFile=%E/state/environment
# KOBO_* secrets, generated by create-module (mode 0600)
EnvironmentFile=%E/state/secrets.env
WorkingDirectory=%E/state
Restart=always
RestartSec=10
TimeoutStartSec=600
TimeoutStopSec=70
ExecStartPre=/bin/rm -f %t/mongo-app.pid %t/mongo-app.ctr-id
ExecStart=/usr/bin/podman run --conmon-pidfile %t/mongo-app.pid \
    --cidfile %t/mongo-app.ctr-id --cgroups=no-conmon \
    --pod-id-file %t/kobotoolbox.pod-id --replace -d --name mongo-app \
    --volume=mongo-data:/data/db:Z \
    ${MONGO_IMAGE} --bind_ip 127.0.0.1
ExecStartPost=/usr/bin/bash %E/bin/wait-ready mongo-app mongosh --quiet --eval "db.runCommand({ping: 1})"
ExecStop=/usr/bin/podman stop --ignore --cidfile %t/mongo-app.ctr-id -t 10
ExecStopPost=/usr/bin/podman rm --ignore -f --cidfile %t/mongo-app.ctr-id
SyslogIdentifier=%u
PIDFile=%t/mongo-app.pid
Type=forking

[Install]
WantedBy=default.target
