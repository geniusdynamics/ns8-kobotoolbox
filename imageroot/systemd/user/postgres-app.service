#
# Reports started when PostgreSQL accepts TCP connections: the server that
# initializes a new database listens on the Unix socket only.

[Unit]
Description=Podman postgres-app.service
BindsTo=kobotoolbox.service
After=kobotoolbox.service
Before=kpi-app.service kpi_worker-app.service

[Service]
Environment=PODMAN_SYSTEMD_UNIT=%n
EnvironmentFile=%E/state/environment
# KOBO_* secrets, generated by create-module (mode 0600)
EnvironmentFile=%E/state/secrets.env
WorkingDirectory=%E/state
Restart=always
RestartSec=10
TimeoutStartSec=600
TimeoutStopSec=70
ExecStartPre=/bin/rm -f %t/postgres-app.pid %t/postgres-app.ctr-id
ExecStart=/usr/bin/podman run --conmon-pidfile %t/postgres-app.pid \
    --cidfile %t/postgres-app.ctr-id --cgroups=no-conmon \
    --pod-id-file %t/kobotoolbox.pod-id --replace -d --name postgres-app \
    --env-file=%E/state/postgres.env \
    --env=POSTGRES_PASSWORD=${KOBO_DB_PASSWORD} \
    --volume=postgres-data:/var/lib/postgresql/data:Z \
    ${POSTGIS_IMAGE}
ExecStartPost=/usr/bin/bash %E/bin/wait-ready postgres-app pg_isready -h 127.0.0.1 -U kobo
ExecStop=/usr/bin/podman stop --ignore --cidfile %t/postgres-app.ctr-id -t 10
ExecStopPost=/usr/bin/podman rm --ignore -f --cidfile %t/postgres-app.ctr-id
SyslogIdentifier=%u
PIDFile=%t/postgres-app.pid
Type=forking

[Install]
WantedBy=default.target
