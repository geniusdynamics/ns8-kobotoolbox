[Unit]
Description=Podman enketo_express-app.service
BindsTo=kobotoolbox.service
After=kobotoolbox.service redis-app.service

[Service]
Environment=PODMAN_SYSTEMD_UNIT=%n
EnvironmentFile=%E/state/environment
# KOBO_* secrets, generated by create-module (mode 0600)
EnvironmentFile=%E/state/secrets.env
WorkingDirectory=%E/state
Restart=always
RestartSec=10
TimeoutStopSec=70
ExecStartPre=/bin/rm -f %t/enketo_express-app.pid %t/enketo_express-app.ctr-id
ExecStart=/usr/bin/podman run --conmon-pidfile %t/enketo_express-app.pid \
    --cidfile %t/enketo_express-app.ctr-id --cgroups=no-conmon \
    --pod-id-file %t/kobotoolbox.pod-id --replace -d --name enketo_express-app \
    --env-file=%E/state/enketo.env \
    --env=ENKETO_LINKED_FORM_AND_DATA_SERVER_API_KEY=${KOBO_ENKETO_API_KEY} \
    --env=ENKETO_ENCRYPTION_KEY=${KOBO_ENKETO_ENCRYPTION_KEY} \
    --env=ENKETO_LESS_SECURE_ENCRYPTION_KEY=${KOBO_ENKETO_LESS_SECURE_ENCRYPTION_KEY} \
    ${ENKETO_EXPRESS_EXTRA_WIDGETS_IMAGE}
ExecStop=/usr/bin/podman stop --ignore --cidfile %t/enketo_express-app.ctr-id -t 10
ExecStopPost=/usr/bin/podman rm --ignore -f --cidfile %t/enketo_express-app.ctr-id
SyslogIdentifier=%u
PIDFile=%t/enketo_express-app.pid
Type=forking

[Install]
WantedBy=default.target
