set -e -o pipefail
exec 1>&2 # Redirect any output to the journal (stderr)

# The backup holds secrets.env: restore the database with the same password
KOBO_DB_PASSWORD=$(grep -m1 '^KOBO_DB_PASSWORD=' secrets.env | cut -d= -f2-)
test -n "${KOBO_DB_PASSWORD}"

#
# PostgreSQL: the image initializes the kobotoolbox database, then runs
# the restore script and stops
#
mkdir -vp restore
cat - >restore/zz_kobotoolbox_restore.sh <<'EOS'
psql -U kobo -d postgres -c 'CREATE DATABASE kobocat OWNER kobo'
# The PostGIS image already created some extensions: pg_restore reports
# them as errors, and goes on
pg_restore --no-owner --no-privileges -U kobo -d kobotoolbox /dumps/kobotoolbox.pg_dump
pg_restore --no-owner --no-privileges -U kobo -d kobocat /dumps/kobocat.pg_dump
docker_temp_server_stop
exit 0
EOS
trap 'rm -rfv restore/' EXIT

podman run \
    --rm \
    --network=none \
    --volume=./restore:/docker-entrypoint-initdb.d/:Z \
    --volume=./kobotoolbox.pg_dump:/dumps/kobotoolbox.pg_dump:ro,Z \
    --volume=./kobocat.pg_dump:/dumps/kobocat.pg_dump:ro,Z \
    --volume=postgres-data:/var/lib/postgresql/data:Z \
    --replace --name=restore_db \
    --env=POSTGRES_DB=kobotoolbox \
    --env=POSTGRES_USER=kobo \
    --env=POSTGRES_PASSWORD="${KOBO_DB_PASSWORD}" \
    "${POSTGIS_IMAGE}"

#
# MongoDB: start a temporary server and load the archive from stdin
#
podman run \
    --rm \
    --interactive \
    --network=none \
    --volume=mongo-data:/data/db:Z \
    --replace --name=restore_mongo \
    --entrypoint=/bin/bash \
    "${MONGO_IMAGE}" \
    -c 'mongod --fork --logpath /tmp/mongod.log --bind_ip 127.0.0.1 && mongorestore --quiet --archive --drop; ec=$?; mongod --shutdown; exit $ec' \
    < formhub.mongo_archive

rm -vf kobotoolbox.pg_dump kobocat.pg_dump formhub.mongo_archive
