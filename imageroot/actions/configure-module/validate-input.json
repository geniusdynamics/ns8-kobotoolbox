{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "Configure kobotoolbox",
    "$id": "http://nethserver.org/json-schema/task/input/kobotoolbox/configure-module",
    "description": "Configure kobotoolbox",
    "examples": [
        {
            "host": "kobotoolbox.domain.org",
            "http2https": true,
            "lets_encrypt": true
        }
    ],
    "type": "object",
    "required": [
        "host",
        "http2https",
        "lets_encrypt"
    ],
    "properties": {
        "host": {
            "type": "string",
            "description": "Host name for the application, like 'kobotoolbox.domain.org'",
            "format": "hostname",
            "pattern": "\\."
        },
        "lets_encrypt": {
            "type": "boolean",
            "title": "Let's Encrypt certificate",
            "description": "Request a valid Let's Encrypt certificate."
        },
        "http2https": {
            "type": "boolean",
            "title": "HTTP to HTTPS redirection",
            "description": "Redirect all the HTTP requests to HTTPS"
        },
        "oidc": {
            "type": "object",
            "required": [
                "enabled"
            ],
            "additionalProperties": false,
            "properties": {
                "enabled": {
                    "type": "boolean"
                },
                "issuer": {
                    "type": "string",
                    "maxLength": 2048
                },
                "client_id": {
                    "type": "string",
                    "maxLength": 255
                },
                "client_secret": {
                    "type": "string",
                    "maxLength": 4096
                },
                "name": {
                    "type": "string",
                    "maxLength": 64
                },
                "mode": {
                    "enum": [
                        "manual",
                        "ns8"
                    ]
                },
                "provider": {
                    "type": "string",
                    "maxLength": 128
                },
                "domain": {
                    "type": "string",
                    "maxLength": 255
                }
            }
        },
        "django_admin_enabled": {
            "type": "boolean",
            "description": "Expose the staff-only Django Admin URL through the module web route."
        }
    }
}
