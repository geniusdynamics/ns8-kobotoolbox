import json
import sys

import agent

request = json.load(sys.stdin)
host = request["host"]

# Settings of the KPI and Enketo images that are not secret. The secrets
# come from secrets.env, see the systemd units. All the containers share
# the pod network: services are reached on 127.0.0.1. nginx listens on
# 8080 and serves KPI on / and Enketo on /enketo/.
public_url = f"https://{host}"
kpi = {
    "KPI_PREFIX": "/",
    "DJANGO_DEBUG": "False",
    "PUBLIC_REQUEST_SCHEME": "https",
    # Traefik terminates TLS and sends X-Forwarded-Proto
    "SECURE_PROXY_SSL_HEADER": "HTTP_X_FORWARDED_PROTO,https",
    "DJANGO_ALLOWED_HOSTS": f"{host} 127.0.0.1 localhost",
    "DJANGO_CSRF_TRUSTED_ORIGINS": public_url,
    "KOBOFORM_URL": public_url,
    "KOBOFORM_INTERNAL_URL": "http://127.0.0.1:8080",
    # The KoboCAT endpoints are served by KPI on the same host. KPI
    # redirects the login page to KOBOFORM_URL when the request URL equals
    # KOBOCAT_URL (ConditionalRedirects), which would loop on a single
    # host: the explicit default port keeps the two URLs different.
    "KOBOCAT_URL": f"{public_url}:443",
    "KOBOCAT_INTERNAL_URL": "http://127.0.0.1:8080",
    "ENKETO_URL": f"{public_url}/enketo",
    "ENKETO_INTERNAL_URL": "http://127.0.0.1:8005/enketo",
    "POSTGRES_HOST": "127.0.0.1",
    "POSTGRES_PORT": "5432",
    "POSTGRES_USER": "kobo",
    "KPI_POSTGRES_DB": "kobotoolbox",
    "KC_POSTGRES_DB": "kobocat",
    "KOBO_MONGO_HOST": "127.0.0.1",
    "KOBO_MONGO_PORT": "27017",
    "MONGO_DB_NAME": "formhub",
    "MONGO_DB_URL": "mongodb://127.0.0.1:27017/formhub",
    "CELERY_BROKER_URL": "redis://127.0.0.1:6379/1",
    "REDIS_SESSION_URL": "redis://127.0.0.1:6379/2",
    "CACHE_URL": "redis://127.0.0.1:6379/5",
    "ENKETO_REDIS_MAIN_URL": "redis://127.0.0.1:6379/0",
    "KOBO_SUPERUSER_USERNAME": "admin",
    "CELERY_AUTOSCALE_MIN": "1",
    "CELERY_AUTOSCALE_MAX": "2",
    # uWSGI settings read by docker/uwsgi.ini of the KPI image
    "UWSGI_WORKERS_COUNT": "2",
    "UWSGI_CHEAPER_WORKERS_COUNT": "1",
    "UWSGI_MAX_REQUESTS": "512",
    "UWSGI_CHEAPER_RSS_LIMIT_SOFT": "134217728",
    "UWSGI_HARAKIRI": "120",
    "UWSGI_WORKER_RELOAD_MERCY": "120",
}
agent.write_envfile("kpi.env", kpi)

enketo = {
    "ENKETO_BASE_PATH": "/enketo",
    "ENKETO_PORT": "8005",
    "ENKETO_REDIS_MAIN_HOST": "127.0.0.1",
    "ENKETO_REDIS_MAIN_PORT": "6379",
    "ENKETO_REDIS_CACHE_HOST": "127.0.0.1",
    "ENKETO_REDIS_CACHE_PORT": "6379",
    "ENKETO_LINKED_FORM_AND_DATA_SERVER_NAME": "KoboToolbox",
    "ENKETO_LINKED_FORM_AND_DATA_SERVER_SERVER_URL": "",
}
agent.write_envfile("enketo.env", enketo)

agent.write_envfile("postgres.env", {
    "POSTGRES_DB": "kobotoolbox",
    "POSTGRES_USER": "kobo",
})
