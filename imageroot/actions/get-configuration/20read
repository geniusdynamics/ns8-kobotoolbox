#
# Read configuration. Every module with the reader role can run this
# action: never return secrets here.
#

import json
import os
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[2]/"bin"))
from oidc_config import callback_path, load, providers


oidc = load()
public_oidc = {key: oidc[key] for key in ("issuer", "client_id", "mode", "provider", "domain", "name") if key in oidc}
public_oidc.update(enabled=oidc.get("enabled", False), secret_configured=bool(oidc.get("client_secret")))
if oidc.get("issuer"):
    public_oidc["callback_path"] = callback_path(oidc)

config = {
    "oidc": public_oidc,
    "django_admin_enabled": os.getenv("KOBO_DJANGO_ADMIN_ENABLED", "True") == "True",
    "oidc_providers": providers(),
    "host": os.getenv("TRAEFIK_HOST", ""),
    "http2https": os.getenv("TRAEFIK_HTTP2HTTPS") == "True",
    "lets_encrypt": os.getenv("TRAEFIK_LETS_ENCRYPT") == "True",
}

json.dump(config, fp=sys.stdout)
