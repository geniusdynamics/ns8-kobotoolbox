import os
import secrets

# Secrets of the instance, generated once. They must not go through
# agent.set_env(): the module environment is stored in Redis, readable by
# other modules. Keep them in a private file, loaded by the systemd units
# and included in the module backup. The values are URL safe: the database
# password is part of the DATABASE_URL of KPI.
values = {
    "KOBO_DB_PASSWORD": secrets.token_hex(16),
    "KOBO_DJANGO_SECRET_KEY": secrets.token_urlsafe(48),
    "KOBO_ENKETO_API_KEY": secrets.token_hex(24),
    "KOBO_ENKETO_ENCRYPTION_KEY": secrets.token_hex(24),
    "KOBO_ENKETO_LESS_SECURE_ENCRYPTION_KEY": secrets.token_hex(24),
    "KOBO_SUPERUSER_PASSWORD": secrets.token_urlsafe(12),
}
path = os.path.join(os.environ["AGENT_STATE_DIR"], "secrets.env")
fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
with os.fdopen(fd, "w") as fp:
    for key, value in values.items():
        fp.write(f"{key}={value}\n")
