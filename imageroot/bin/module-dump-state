# Runs in the state directory before the backup
set -e -o pipefail

echo "Dumping the KoboToolbox databases"
podman exec postgres-app pg_dump -U kobo --format=c kobotoolbox > kobotoolbox.pg_dump
podman exec postgres-app pg_dump -U kobo --format=c kobocat > kobocat.pg_dump
podman exec mongo-app mongodump --quiet --archive --db=formhub > formhub.mongo_archive
